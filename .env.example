# HRMS Backend — copy to .env and fill in your values
# cp .env.example .env
#
# 1. Create a Supabase project at https://supabase.com
# 2. Run backend/sql/setup-hrms-database.sql in Supabase SQL Editor
# 3. Paste Project Settings → API keys below

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=5002
NODE_ENV=development

# -----------------------------------------------------------------------------
# Auth (JWT)
# -----------------------------------------------------------------------------
# Required in production — change from the dev default
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Supabase (database)
# -----------------------------------------------------------------------------
# Get these from: Supabase Dashboard → Project Settings → API

# Project URL (required)
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable key (required if service role is not set)
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role key (strongly recommended for the Express API — bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Fallback names (optional)
# If SUPABASE_URL / SUPABASE_ANON_KEY are unset, the backend also checks these
# (same values as Next.js frontends often use):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
